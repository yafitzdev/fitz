# .gitignore
# Repository whitelist. Everything is ignored unless explicitly allowed below.
*

# Versioned project surfaces.
!.github/
!.github/**
!docs/
!docs/**
!benchmarks/
!benchmarks/**
!examples/
!examples/**
!fitz_sage/
!fitz_sage/**
!tests/
!tests/**
!tools/
!tools/**

# Root metadata.
!.gitignore
!CHANGELOG.md
!CONTRIBUTING.md
!LICENSE
!LIMITATIONS.md
!pyproject.toml
!README.md

# Local-only docs.
docs/roadmap/
docs/roadmap/**

# Generated artifacts inside versioned trees.
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
.pytest_cache/
**/.pytest_cache/
.hypothesis/
**/.hypothesis/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.fitz/
**/.fitz/
.e2e_cache/
**/.e2e_cache/
*.egg-info/
**/*.egg-info/
build/
dist/
tools/retrieval_eval/results/
tools/retrieval_eval/results/**
benchmarks/results/
benchmarks/results/**
.bench_workspace/
.bench_workspace/**
